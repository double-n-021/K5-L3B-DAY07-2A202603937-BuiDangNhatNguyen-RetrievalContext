# Cấu hình LLM Provider cho Agent Day 07 (Sao chép thành file .env và điền key thật)
PROVIDER=gemini
MODEL=gemini-2.5-flash
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Hoặc dùng Groq Free API (tốc độ cao, OpenAI-compatible):
# PROVIDER=groq
# MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=YOUR_GROQ_API_KEY

# Tùy chọn cấu hình dự phòng nếu dùng OpenAI hoặc OpenRouter
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
